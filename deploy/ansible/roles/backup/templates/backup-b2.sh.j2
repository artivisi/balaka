#!/bin/bash
# Upload the newest local backup to Backblaze B2
# Generated by Ansible - do not edit manually

set -eo pipefail

LOG_PREFIX="B2"
# shellcheck source=/dev/null
source "/opt/{{ app_name }}/scripts/backup-lib.sh"

export RCLONE_CONFIG="/opt/{{ app_name }}/.config/rclone/rclone.conf"
export GNUPGHOME="/opt/{{ app_name }}/.gnupg"
mkdir -p "${GNUPGHOME}"
chmod 700 "${GNUPGHOME}"

if [ "${BACKUP_B2_ENABLED}" != "true" ]; then
    fail "Backblaze B2 upload is disabled in ${CONFIG_FILE} but the job is scheduled"
fi
if [ -z "${BACKUP_B2_BUCKET}" ]; then
    fail "BACKUP_B2_BUCKET is not configured"
fi

DESTINATION="${RCLONE_B2_REMOTE}:${BACKUP_B2_BUCKET}"
RETENTION_DAYS=$((BACKUP_B2_RETENTION_WEEKS * 7))

# shellcheck source=/dev/null
source "/opt/{{ app_name }}/scripts/backup-upload.sh"
