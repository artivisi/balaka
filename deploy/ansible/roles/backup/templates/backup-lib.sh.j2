#!/bin/bash
# Shared functions for the backup scripts of {{ app_name }}
# Generated by Ansible - do not edit manually
#
# Sourced by backup.sh, backup-b2.sh, backup-gdrive.sh and backup-check.sh.
# Callers set LOG_PREFIX before sourcing.

CONFIG_FILE="/opt/{{ app_name }}/backup.conf"
if [ ! -f "${CONFIG_FILE}" ]; then
    echo "ERROR: Config file not found: ${CONFIG_FILE}" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "${CONFIG_FILE}"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ${LOG_PREFIX}: $1" | tee -a "${LOG_FILE}"
}

# Sends a failure alert through every configured channel. A failed alert is
# logged; it does not change the exit status the caller is about to return.
alert() {
    local message="$1"
    local host
    host=$(hostname -f 2>/dev/null || hostname)

    if [ "${ALERT_TELEGRAM_ENABLED}" = "true" ]; then
        if ! curl -sS --max-time 30 -o /dev/null -w '%{http_code}' \
                "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
                --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
                --data-urlencode "text=BACKUP FAILED ${APP_NAME}@${host} [${LOG_PREFIX}]: ${message}" \
                | grep -q '^200$'; then
            log "ERROR: Telegram alert could not be sent"
        fi
    fi

    if [ "${ALERT_WEBHOOK_ENABLED}" = "true" ]; then
        if ! curl -sS --max-time 30 -o /dev/null -X POST "${ALERT_WEBHOOK_URL}" \
                -H "Content-Type: application/json" \
                -d "{\"status\": \"FAILED\", \"app\": \"${APP_NAME}\", \"host\": \"${host}\", \"job\": \"${LOG_PREFIX}\", \"message\": \"${message//\"/\\\"}\"}"; then
            log "ERROR: Webhook alert could not be sent"
        fi
    fi
}

fail() {
    log "ERROR: $1"
    alert "$1"
    exit 1
}

newest_archive() {
    # Prints the newest local archive, or nothing when there is none.
    find "${BACKUP_DIR}" -maxdepth 1 -type f -name "${APP_NAME}_*.tar.gz" -printf '%T@ %p\n' \
        | sort -rn | head -1 | cut -d' ' -f2-
}

# Fails when the archive is older than BACKUP_MAX_AGE_HOURS. Uploading a stale
# archive would report success while no new backup exists.
require_fresh() {
    local archive="$1"
    local age_hours
    age_hours=$(( ( $(date +%s) - $(stat -c %Y "${archive}") ) / 3600 ))
    if [ "${age_hours}" -ge "${BACKUP_MAX_AGE_HOURS}" ]; then
        fail "Newest archive $(basename "${archive}") is ${age_hours}h old (limit ${BACKUP_MAX_AGE_HOURS}h). The local backup job did not produce a new archive."
    fi
}

# Fails when the archive cannot be listed, has no non-empty database.sql, or
# its manifest is not valid JSON with a checksum for every listed file.
verify_archive() {
    local archive="$1"
    local name
    name=$(basename "${archive}" .tar.gz)

    if ! tar -tzf "${archive}" > /dev/null 2>>"${LOG_FILE}"; then
        fail "Archive $(basename "${archive}") is not a readable tar.gz"
    fi

    local db_size
    db_size=$(tar -tvzf "${archive}" "${name}/database.sql" 2>>"${LOG_FILE}" | awk '{print $3}')
    if [ -z "${db_size}" ] || [ "${db_size}" -eq 0 ]; then
        fail "Archive $(basename "${archive}") has an empty or missing database.sql"
    fi

    if ! tar -xOzf "${archive}" "${name}/manifest.json" 2>>"${LOG_FILE}" | python3 -c '
import json, sys
m = json.load(sys.stdin)
db = m["files"]["database"]
assert len(db["checksum_sha256"]) == 64, "database checksum"
docs = m["files"]["documents"]
assert docs["checksum_sha256"] is None or len(docs["checksum_sha256"]) == 64, "documents checksum"
' 2>>"${LOG_FILE}"; then
        fail "Archive $(basename "${archive}") has an invalid manifest.json"
    fi
}
