#!/bin/bash
# Upload the newest local backup to Google Drive
# Generated by Ansible - do not edit manually

set -eo pipefail

LOG_PREFIX="GDrive"
# shellcheck source=/dev/null
source "/opt/{{ app_name }}/scripts/backup-lib.sh"

export RCLONE_CONFIG="/opt/{{ app_name }}/.config/rclone/rclone.conf"
export GNUPGHOME="/opt/{{ app_name }}/.gnupg"
mkdir -p "${GNUPGHOME}"
chmod 700 "${GNUPGHOME}"

if [ "${BACKUP_GDRIVE_ENABLED}" != "true" ]; then
    fail "Google Drive upload is disabled in ${CONFIG_FILE} but the job is scheduled"
fi

DESTINATION="${RCLONE_GDRIVE_REMOTE}:${BACKUP_GDRIVE_FOLDER}"
RETENTION_DAYS=$((BACKUP_GDRIVE_RETENTION_MONTHS * 30))

# shellcheck source=/dev/null
source "/opt/{{ app_name }}/scripts/backup-upload.sh"
