#!/bin/bash
# Encrypt and upload the newest local archive to DESTINATION.
# Generated by Ansible - do not edit manually
#
# Sourced by backup-b2.sh and backup-gdrive.sh after backup-lib.sh, with
# DESTINATION (rclone remote:path) and RETENTION_DAYS set.

ENCRYPTED_FILE=""
cleanup_encrypted() {
    if [ -n "${ENCRYPTED_FILE}" ] && [ -f "${ENCRYPTED_FILE}" ]; then
        rm -f -- "${ENCRYPTED_FILE}"
    fi
}
trap 'cleanup_encrypted; fail "Unexpected failure at line ${LINENO}: ${BASH_COMMAND}"' ERR

BACKUP_FILE=$(newest_archive)
if [ -z "${BACKUP_FILE}" ]; then
    fail "No archive in ${BACKUP_DIR}"
fi
require_fresh "${BACKUP_FILE}"
verify_archive "${BACKUP_FILE}"

BASENAME=$(basename "${BACKUP_FILE}")
ENCRYPTED_FILE=$(mktemp --suffix=.gpg "/tmp/${BASENAME}.XXXXXX")

log "Starting upload: ${BASENAME} -> ${DESTINATION}"

if ! gpg --symmetric --cipher-algo AES256 \
    --passphrase-file "${BACKUP_KEY}" \
    --batch --yes \
    -o "${ENCRYPTED_FILE}" "${BACKUP_FILE}" 2>>"${LOG_FILE}"; then
    cleanup_encrypted
    fail "Encryption of ${BASENAME} failed"
fi

if ! rclone copyto "${ENCRYPTED_FILE}" "${DESTINATION}/${BASENAME}.gpg" --log-file="${LOG_FILE}" --log-level=INFO; then
    cleanup_encrypted
    fail "Upload of ${BASENAME}.gpg to ${DESTINATION} failed, see ${LOG_FILE}"
fi
cleanup_encrypted

# Confirm the object exists and is not empty.
REMOTE_SIZE=$(rclone lsjson "${DESTINATION}/${BASENAME}.gpg" 2>>"${LOG_FILE}" \
    | python3 -c 'import json,sys; e=json.load(sys.stdin); print(e[0]["Size"] if e else "")')
if [ -z "${REMOTE_SIZE}" ] || [ "${REMOTE_SIZE}" -eq 0 ]; then
    fail "${BASENAME}.gpg is missing or empty in ${DESTINATION} after upload"
fi

log "Deleting objects older than ${RETENTION_DAYS} days from ${DESTINATION}"
if ! rclone delete "${DESTINATION}/" --min-age "${RETENTION_DAYS}d" --log-file="${LOG_FILE}" --log-level=INFO; then
    log "ERROR: Retention cleanup in ${DESTINATION} failed"
    alert "Retention cleanup in ${DESTINATION} failed; the upload of ${BASENAME}.gpg succeeded"
fi

trap - ERR
log "Upload completed: ${BASENAME}.gpg (${REMOTE_SIZE} bytes)"
