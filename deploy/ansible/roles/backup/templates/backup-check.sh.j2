#!/bin/bash
# Daily backup freshness check for {{ app_name }}
# Generated by Ansible - do not edit manually
#
# Runs after the backup and upload jobs. Alerts when the newest local archive or
# the newest object in an enabled remote is older than BACKUP_MAX_AGE_HOURS, so a
# job that stopped running (cron entry gone, script failing before it can alert)
# still surfaces.

set -eo pipefail

LOG_PREFIX="Check"
# shellcheck source=/dev/null
source "/opt/{{ app_name }}/scripts/backup-lib.sh"

export RCLONE_CONFIG="/opt/{{ app_name }}/.config/rclone/rclone.conf"

trap 'fail "Unexpected failure at line ${LINENO}: ${BASH_COMMAND}"' ERR

PROBLEMS=()

LOCAL=$(newest_archive)
if [ -z "${LOCAL}" ]; then
    PROBLEMS+=("no local archive in ${BACKUP_DIR}")
else
    AGE_HOURS=$(( ( $(date +%s) - $(stat -c %Y "${LOCAL}") ) / 3600 ))
    if [ "${AGE_HOURS}" -ge "${BACKUP_MAX_AGE_HOURS}" ]; then
        PROBLEMS+=("newest local archive $(basename "${LOCAL}") is ${AGE_HOURS}h old")
    fi
fi

# Prints the age in hours of the newest object under an rclone path, or
# nothing when the listing fails or is empty.
remote_age_hours() {
    rclone lsjson "$1/" 2>>"${LOG_FILE}" | python3 -c '
import json, sys, datetime
entries = [e for e in json.load(sys.stdin) if not e["IsDir"]]
if entries:
    newest = max(datetime.datetime.fromisoformat(e["ModTime"].replace("Z", "+00:00")) for e in entries)
    print(int((datetime.datetime.now(datetime.timezone.utc) - newest).total_seconds() // 3600))
'
}

check_remote() {
    local label="$1" destination="$2" age
    if ! age=$(remote_age_hours "${destination}"); then
        PROBLEMS+=("${label}: listing ${destination} failed")
    elif [ -z "${age}" ]; then
        PROBLEMS+=("${label}: ${destination} is empty")
    elif [ "${age}" -ge "${BACKUP_MAX_AGE_HOURS}" ]; then
        PROBLEMS+=("${label}: newest object in ${destination} is ${age}h old")
    fi
}

if [ "${BACKUP_B2_ENABLED}" = "true" ]; then
    check_remote "B2" "${RCLONE_B2_REMOTE}:${BACKUP_B2_BUCKET}"
fi
if [ "${BACKUP_GDRIVE_ENABLED}" = "true" ]; then
    check_remote "Google Drive" "${RCLONE_GDRIVE_REMOTE}:${BACKUP_GDRIVE_FOLDER}"
fi

trap - ERR
if [ "${#PROBLEMS[@]}" -gt 0 ]; then
    MESSAGE=$(printf '%s; ' "${PROBLEMS[@]}")
    fail "${MESSAGE%; } (limit ${BACKUP_MAX_AGE_HOURS}h)"
fi
log "All backups younger than ${BACKUP_MAX_AGE_HOURS}h"
